INSTANCE_ID=main
BRAND_NAME=Instituto Trader
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_BOT_TOKEN=
# Um ou mais IDs numericos, separados por virgula.
SOURCE_CHAT_IDS=
DESTINATION_CHAT_ID=
BOT_ADMIN_IDS=
BOT_ENABLED=true
DRY_RUN=true
DATA_DIR=./data
SESSION_DIR=./sessions
LOG_DIR=./logs
MT5_CREDENTIAL_KEY=
MT5_TEMPLATE_PATH=
MT5_BROKER_TEMPLATES=
# Ex.: HFM=HFMarketsGlobal-Live1|HFMarketsGlobal-Live3;DOOPRIME=DooTechnology-Demo|DooTechnology-Live
MT5_BROKER_SERVERS=
MT5_BASE_DIR=./mt5_accounts
MT5_EXECUTION_MODE=simulation
MT5_MAX_ACCOUNTS_PER_VPS=10
MT5_ONBOARDING_URL=
CLIENT_APP_URL=
ONBOARDING_HOST=127.0.0.1
ONBOARDING_PORT=8080
ALLOW_LIVE_ACCOUNTS=false
DEFAULT_PENDING_EXPIRATION_MINUTES=120
GLOBAL_EXECUTION_KILL_SWITCH=true
OPERATIONAL_ALERTS_ENABLED=true
HEALTH_CHECK_INTERVAL_SECONDS=30
HEALTH_STALE_AFTER_SECONDS=90
OPERATIONAL_ALERT_REPEAT_MINUTES=360
# Dia do servidor MT5 (UTC+2 no inverno e UTC+3 no verao europeu).
DAILY_PERFORMANCE_TIMEZONE=Europe/Athens
# Calendário gratuito do Forex Factory. A chave abaixo é opcional e troca o provedor.
MARKET_NEWS_ENABLED=false
ECONOMIC_CALENDAR_API_KEY=
MARKET_NEWS_MINUTES_BEFORE=10
MARKET_NEWS_MINUTES_AFTER=10
MARKET_NEWS_POLL_SECONDS=30
# OCR local e gratuito para canais que desenham o sinal dentro da foto.
# Habilite somente nos IDs analisados; o sinal exige confirmação numérica pela legenda.
TELEGRAM_IMAGE_OCR_ENABLED=false
TELEGRAM_IMAGE_OCR_CHAT_IDS=
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# Identidade da VPS fisica (nao confundir com INSTANCE_ID, que e a marca/instancia).
# So obrigatorio quando CENTRAL_SYNC_ENABLED=true.
NODE_ID=
NODE_LABEL=
# Etapa 2: shadow-write de sinais para o backend central (Supabase, schema "portal").
# Desligado por padrao -- liga sem afetar o processamento real quando true.
CENTRAL_SYNC_ENABLED=false
CENTRAL_SYNC_DATABASE_URL=
CENTRAL_SYNC_POLL_SECONDS=5
CENTRAL_SYNC_MAX_BATCH=20
# Etapa 3: acima desse tempo sem terminar (created_at), um item do outbox conta
# como "replicacao atrasada" no monitor operacional.
CENTRAL_SYNC_DELIVERY_LAG_SECONDS=600
# Etapa 3B: auditoria por amostragem do conteudo ja drenado contra o Supabase
# real (so sinais/content_signature) -- quantos sinais por ciclo e a cada
# quanto tempo, dentro do proprio loop de drenagem.
CENTRAL_SYNC_AUDIT_SAMPLE_SIZE=5
CENTRAL_SYNC_AUDIT_INTERVAL_SECONDS=1800
# Etapa 4: agente de execucao (so simulacao nesta etapa -- nao chama MT5/corretora
# nenhuma). Diferente do shadow-write acima: fala com o Supabase via HTTP
# (PostgREST + Auth), nao conexao Postgres direta -- as RPCs de agent_api exigem
# um JWT real. A senha nunca deve ser gerada nem vista por uma IA -- defina
# direto no painel do Supabase (Authentication > Users) e guarde num gerenciador
# de senhas, mesma disciplina do CENTRAL_SYNC_DATABASE_URL.
EXECUTION_AGENT_ENABLED=false
# simulation (padrao, nunca fala com corretora) ou demo_execution (Etapa 5c --
# executa de verdade, so pra uma conta demo dedicada e isolada do caminho
# local, nunca uma conta de cliente real).
EXECUTION_AGENT_MODE=simulation
SUPABASE_URL=
SUPABASE_ANON_KEY=
EXECUTION_AGENT_EMAIL=
EXECUTION_AGENT_PASSWORD=
EXECUTION_AGENT_POLL_SECONDS=5
EXECUTION_AGENT_CLAIM_LIMIT=5
EXECUTION_AGENT_LEASE_SECONDS=60
# Etapa 5d: id(s) local(is) de mt5_accounts que sao contas demo dedicadas,
# isoladas do caminho local (execution_profiles.enabled=0 pra elas) -- o
# listener enfileira job pending de verdade na fila central pra cada uma,
# pra todo sinal aceito, sem checar assinatura de canal (uso interno/teste,
# nunca uma conta de cliente real). Vazio por padrao -- nada muda sem
# configurar isto explicitamente.
QUEUE_PILOT_ACCOUNT_IDS=
# Backup criptografado, fora da VPS, para o Backblaze B2. Ver README, secao "Backup".
BACKUP_ENCRYPTION_KEY=
BACKUP_RETENTION_DAYS=14
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
